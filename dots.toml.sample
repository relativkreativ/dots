# dots configuration
#
# Copy this file to the root of your dotfiles repository as:
#
#   dots.toml
#
# The repository root mirrors $HOME. Files are symlinked by default.
# Adjust the configuration below only where you want to override
# the default behavior.
#
# dots deliberately supports a narrow TOML subset.
#
# Supported: [defaults], [selectors], and ["relative/path"] tables; simple
# double-quoted strings; and triple-quoted selector command blocks. Comments
# begin with #. Supported keys: defaults.strategy; selector names mapped to
# Bash commands; and target/strategy in entries. Strings do not support escapes
# or embedded quotes. Paths must be non-empty, relative, and contain no ..
# components. Explicit entries suppress implicit scanning of their source path
# and its descendants.

[defaults]
strategy = "symlink"

[selectors]
os = """
case "$(uname -s)" in
  Linux)  echo linux ;;
  Darwin) echo macos ;;
esac
"""

distro = """
if [[ -r /etc/os-release ]]; then
  . /etc/os-release
  echo "$ID"
fi
"""

host = "hostname -s"
